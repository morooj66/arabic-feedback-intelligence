# Copy this file to .env (or otherwise set as real environment variables)
# and fill in a real key before running scripts/run_classification.py live.
# Never commit a real key.

GEMINI_API_KEY=

# Classification composition. Default is fully local/frozen. The hybrid mode
# is experimental and sends only PII-redacted comment text to OpenRouter for
# Topic classification; it requires explicit configuration and an API key.
RCS_CLASSIFICATION_MODE=legacy_rcs
OPENROUTER_API_KEY=

# Optional. Response-generation model (default: gemini-3.6-flash). Never commit secrets.
# GEMINI_RESPONSE_MODEL_NAME=gemini-3.6-flash

# Opt-in live smoke test only (pytest tests/test_response_generation_live.py). Default suite never calls Gemini.
# RCS_LIVE_GEMINI=1

# --- Phase 5/5.1 — database ---------------------------------------------
# Unset locally uses a SQLite file automatically. Set to a real
# PostgreSQL URL (e.g. Supabase) to point the server there instead.
# Never commit a real value.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME

# --- Phase 7 — deployment ------------------------------------------------
# Set on the real deployed backend only (never needed for local dev).
# "production" enables Secure/SameSite=None cookies and 0.0.0.0 binding.
# RCS_ENV=production

# Comma-separated exact frontend origin(s) allowed to call this backend
# with credentials. Never a wildcard. Local dev defaults to the Vite dev
# server origins when this is unset.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# --- Official Knowledge — curated corpus (optional; unset = fail-closed) --
# Unset by default: Official Knowledge retrieval always returns
# SUCCESS_EMPTY and Gemini never receives a factual claim. Set this ONLY
# once an organization-approved export has been converted with
# scripts/build_official_knowledge_corpus.py into the documented
# RawOfficialSourceRecord JSON schema (see that module's docstring, and
# rcs.response_intelligence.retrieval.official_corpus's own docstring for
# the required per-record fields, including the mandatory
# provenance_tag == "official_approved" and authoritative == true).
# Never point this at an unapproved file (e.g. an uploaded workbook whose
# provenance/approval has not been confirmed) or at a test fixture.
# OFFICIAL_KNOWLEDGE_SOURCE_PATH=/absolute/path/to/governed_corpus.json

# --- Approved Response Memory — style/pattern source allowlist (optional) -
# Comma-separated exact `source_file` values this organization has
# explicitly approved as production-trustworthy for STYLE-memory
# retrieval only (never factual authority — see contracts.py). Empty by
# default: fails closed with zero eligible entries.
# APPROVED_RESPONSE_SOURCE_ALLOWLIST=

# --- Phase 9 — Microsoft Entra ID SSO (optional; unset = button hidden) --
# All four required together, or SSO stays off and password login is
# unaffected. Never commit real values.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
#
# Must be registered in the Entra app registration's Redirect URIs
# exactly as set here. Local dev default (used when unset) is
# http://localhost:5173/api/auth/microsoft/callback — deliberately the
# Vite dev server's own origin, not the backend's 127.0.0.1:8765, so the
# session cookie set during the callback lands on the same origin the SPA
# later calls /api/session from (Vite proxies /api/* through to the
# backend either way — see web/vite.config.ts). Do not point this at
# 127.0.0.1:8765 locally; that sets the cookie on a host the SPA never
# talks to and the login silently fails to "stick".
# ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/microsoft/callback
#
# Frontend origin the browser lands on after the SSO round trip. Local
# dev default (used when unset) is http://localhost:5173/
# ENTRA_FRONTEND_RETURN_URL=http://localhost:5173/

# Internal AI Evaluation Playground (admin-only, local development ONLY).
# Disabled by default; always disabled when RCS_ENV=production.
# RCS_PLAYGROUND_ENABLED=1

# Reply-safety policy (default ON; set to 0 only to restore the previous behaviour deliberately)
# RCS_REQUIRE_GROUNDING_FOR_FACTUAL_QUESTIONS=1
# RCS_REQUIRE_CORROBORATION_FOR_EXCLUSION=1

# --- Login rate limiting behind a reverse proxy ---------------------------
# Comma-separated IPs/CIDRs of the reverse proxies whose X-Forwarded-For header may be trusted (never a wildcard). Empty = the header is ignored and the
# socket peer is the client address (then all users behind one proxy share one address bucket).
# RCS_TRUSTED_PROXIES=

# --- Self-service password reset (OFF until an email provider is wired) ----
# Needs BOTH a configured sender (rcs.review.email_sender.set_email_sender at startup - none is wired by default) and the public frontend origin below.
# Without them the endpoints answer 503 and the login screen keeps the "contact your administrator" message. Token lifetime is capped at 30 minutes.
# RCS_PASSWORD_RESET_LINK_BASE=https://your-frontend.example.org
# RCS_PASSWORD_RESET_TTL_MINUTES=30

# --- Password reset e-mail (SMTP) -----------------------------------------
# All empty = password reset stays OFF (fail closed). TLS is mandatory; there is no plain-text option.
# Reset also needs RCS_PASSWORD_RESET_LINK_BASE (the public https URL of the frontend, no trailing slash).
# RCS_PASSWORD_RESET_LINK_BASE=
# RCS_SMTP_HOST=
# RCS_SMTP_PORT=587
# RCS_SMTP_SECURITY=starttls     # or: ssl (port 465)
# RCS_SMTP_USERNAME=
# RCS_SMTP_PASSWORD=             # secret: set only in the deployment environment
# RCS_SMTP_FROM=

# --- Synthetic-data DEMO mode (never for production data) ------------------
# Demo mode starts ONLY if all of these are set exactly, the database is a dedicated "rcs_demo*" database, and NO production secret above is set (see docs/DEMO_MODE.md).
# RCS_DEMO_MODE=synthetic-demo
# RCS_DEMO_ACK=THIS_INSTANCE_HOLDS_SYNTHETIC_DATA_ONLY
# Tests never read this file or real credentials (tests/conftest.py); a deliberate live test run must set RCS_ALLOW_LIVE_TEST_SECRETS=1 itself.
